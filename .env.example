# Copia este archivo a .env y ajusta los valores para tu entorno local.
# En producción, estas variables deben inyectarse desde el orquestador
# (Docker, Kubernetes, systemd, etc.), nunca desde un archivo .env.

# --- Servidor HTTP ---
SERVER_PORT=8080
SERVER_READ_TIMEOUT=5s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=10s

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=golang_back
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m
